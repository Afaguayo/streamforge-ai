# StreamForge AI does not read secrets from .env at runtime.
# Platform credentials are entered in the app (Account Connections) and stored in
# Windows Credential Manager under the service name "StreamForge AI".
#
# Stored credential names (secrets::KNOWN_KEYS):
#   kick.client_id        Kick developer app Client ID
#   kick.client_secret    Kick developer app Client Secret
#
# Added in later phases:
#   youtube.oauth_client  Google OAuth desktop client (Phase 5)
#   tiktok.client_key / tiktok.client_secret (Phase 5)
#   meta.app_id / meta.app_secret (Phase 5)
#   llm.api_key           LLM used for moment scoring and metadata (Phase 3)
#
# Optional build-time variables:
# TAURI_SIGNING_PRIVATE_KEY=   # only needed once auto-update is enabled (Phase 7)
